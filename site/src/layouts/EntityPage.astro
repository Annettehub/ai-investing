---
import { Icon } from '@astrojs/starlight/components';
import EntityBlock from '../components/entity/EntityBlock.astro';
import '../styles/entity.css';
const { document: doc, sourcePath, originalHref, preview = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sourceHref = `https://github.com/Annettehub/ai-investing/blob/main/${sourcePath.split('/').map(encodeURIComponent).join('/')}`;
const groups = [
  { title: '今日', links: [{ name: '首页看板', path: '/', icon: 'random' }, { name: '待评审', path: '/reviews/', icon: 'approve-check-circle' }, { name: '投研驾驶舱', path: '/dashboard/h1-2-storage/', icon: 'rocket' }] },
  { title: '价投框架', links: [{ name: '价值投资框架', path: '/investing/value-framework/', icon: 'open-book' }] },
  { title: '知识', links: [{ name: '公司标的', path: '/kb/entities/', icon: 'document', active: true }, { name: '概念框架', path: '/kb/concepts/', icon: 'open-book' }, { name: '投资假设', path: '/kb/hypotheses/', icon: 'notes' }] },
  { title: '输出', links: [{ name: '研究报告', path: '/outputs/reports-0b7ec688/', icon: 'document' }, { name: '长期跟踪', path: '/outputs/tracking-da4dfe3f/', icon: 'right-arrow' }, { name: '周度复盘', path: '/outputs/weekly/', icon: 'notes' }] },
  { title: '资料', links: [{ name: '来源摘要', path: '/kb/sources/', icon: 'document' }, { name: '原始资料', path: '/pipeline/raw-sources/', icon: 'open-book' }, { name: '自动同步', path: '/pipeline/automation/', icon: 'code-branch' }] },
];
const toc = doc.sections.filter((s: any) => s.depth === 2);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(originalHref, Astro.site).href} />
    <title>{doc.name} | AI Investing</title>
  </head>
  <body class="entity-app" data-entity-layout="v1">
    <a class="skip-link" href="#main-content">跳转至正文</a>
    <aside class="app-sidebar" id="app-navigation">
      <a class="app-brand" href={`${base}/`}><span class="brand-mark">AI</span><span><strong>AI Investing</strong><small>投研知识工作台</small></span></a>
      <nav aria-label="主导航">{groups.map(group => <div class="nav-group"><h2>{group.title}</h2>{group.links.map(item => <a href={`${base}${item.path}`} class:list={{ active: item.active }}><Icon name={item.icon as any} size="18" /><span>{item.name}</span></a>)}</div>)}</nav>
      <div class="sidebar-footer"><span class="avatar">安</span><div><strong>Annette</strong><small>AI Investing</small></div><a class="icon-button" href="https://github.com/Annettehub/ai-investing" aria-label="GitHub 仓库" title="GitHub 仓库"><Icon name="github" size="19" /></a></div>
    </aside>
    <header class="app-topbar">
      <button class="icon-button mobile-menu" id="menu-button" aria-label="展开导航" title="展开导航" aria-expanded="false" aria-controls="app-navigation"><Icon name="bars" size="21" /></button>
      <div class="page-search"><Icon name="magnifier" size="18" /><input id="entity-search" type="search" aria-label="搜索本篇档案" placeholder="搜索本篇档案" autocomplete="off" aria-controls="search-results" /><div id="search-results" class="search-results" hidden></div></div>
      <div class="topbar-actions">{preview && <span class="preview-badge">预览</span>}<a class="icon-button" href={sourceHref} title="查看仓库原文" aria-label="查看仓库原文"><Icon name="github" size="20" /></a></div>
    </header>
    <div class="entity-workspace">
      <main id="main-content" data-pagefind-body={!preview || undefined}>
        <nav class="breadcrumbs" aria-label="面包屑"><a href={`${base}/kb/`}>知识</a><span>/</span><a href={`${base}/kb/entities/`}>公司标的</a><span>/</span><span>{doc.code} {doc.name}</span></nav>
        <header class="entity-header">
          <div class="entity-title-row"><span class="ticker">{doc.code}</span><h1>{doc.name}</h1><span class="type-badge">实体档案卡</span></div>
          <p class="source-title">{doc.title}</p>
          <div class="entity-meta"><span class="status-badge healthy">{doc.status}</span>{doc.updated && <span>更新于 <time>{doc.updated}</time></span>}<a href={preview ? originalHref : sourceHref}>{preview ? '正式页面' : '仓库原文'} <Icon name="external" size="14" /></a></div>
          <details class="document-metadata"><summary>建档信息与观点来源</summary><div>{doc.intro.blocks.map((block: any) => <EntityBlock block={block} />)}</div></details>
        </header>
        <div class="valuation-highlights">{doc.highlights.map((metric: any) => <a class="valuation-card" href={metric.href} aria-label={`${metric.label}：${metric.value}，${metric.source}`}><span>{metric.label}</span><strong>{metric.headline}</strong>{metric.qualifier && <span class:list={['valuation-qualifier', { pending: metric.qualifier.includes('待验证') }]}>{metric.qualifier}</span>}<small>{metric.source}</small></a>)}</div>
        <details class="mobile-toc"><summary>档案目录</summary><nav>{toc.map((section: any) => <a href={`#${section.id}`}>{section.title}</a>)}</nav></details>
        <article class="entity-content">{doc.sections.map((section: any) => <section id={section.id} class:list={['entity-section', `module-${section.module}`, { subsection: section.depth === 3 }]} data-section-title={section.title}>
          {section.depth === 2 ? <h2><span class="chapter-number">{section.number}</span>{section.label}</h2> : <h3><span class="subchapter-number">{section.number}</span>{section.label}</h3>}
          {section.competitors?.length ? <div class="competition-grid">{section.competitors.map((blocks: any[]) => <article class="competition-card">{blocks.map(block => <EntityBlock block={block} />)}</article>)}</div> : section.blocks.map((block: any) => <EntityBlock block={block} />)}
        </section>)}</article>
        <footer class="document-footer"><a href={sourceHref}><Icon name="github" size="18" />查看仓库原文</a><a href="#main-content">返回顶部 <Icon name="up-arrow" size="18" /></a></footer>
      </main>
      <aside class="entity-toc"><div><h2>档案目录</h2><nav aria-label="档案目录">{toc.map((section: any) => <a href={`#${section.id}`} data-toc-link><span>{section.number}</span>{section.label}</a>)}</nav></div></aside>
    </div>
    <script>
      const menu = document.querySelector<HTMLButtonElement>('#menu-button');
      const sidebar = document.querySelector<HTMLElement>('.app-sidebar');
      menu?.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded', String(open)); sidebar?.classList.toggle('is-open', open); });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { menu?.setAttribute('aria-expanded', 'false'); sidebar?.classList.remove('is-open'); document.querySelector<HTMLElement>('#search-results')?.setAttribute('hidden', ''); } });

      for (const dashboard of document.querySelectorAll<HTMLElement>('.tracking-dashboard')) {
        const buttons = dashboard.querySelectorAll<HTMLButtonElement>('[data-status-filter]');
        const cards = dashboard.querySelectorAll<HTMLElement>('[data-metric-status]');
        for (const button of buttons) button.addEventListener('click', () => {
          let visible = 0;
          for (const card of cards) { card.hidden = button.dataset.statusFilter !== 'all' && card.dataset.metricStatus !== button.dataset.statusFilter; if (!card.hidden) visible++; }
          for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
          dashboard.querySelector('.filter-result')!.textContent = `显示 ${visible} / ${cards.length} 项`;
        });
      }
      const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
      const sections = [...document.querySelectorAll<HTMLElement>('.entity-section:not(.subsection)')];
      let ticking = false;
      const updateToc = () => {
        let active = sections[0];
        for (const section of sections) { if (section.getBoundingClientRect().top <= 150) active = section; }
        for (const link of tocLinks) { const selected = decodeURIComponent(link.hash.slice(1)) === active?.id; if (selected) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current'); }
        ticking = false;
      };
      window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(updateToc); } }, { passive: true });
      updateToc();
      const search = document.querySelector<HTMLInputElement>('#entity-search')!;
      const results = document.querySelector<HTMLElement>('#search-results')!;
      const entries = [...document.querySelectorAll<HTMLElement>('.entity-section')].map(section => ({ title: section.dataset.sectionTitle!, id: section.id, text: (section.textContent || '').toLowerCase() }));
      search.addEventListener('input', () => {
        const query = search.value.trim().toLowerCase(); results.replaceChildren(); results.hidden = !query;
        if (!query) return;
        const matches = entries.filter(entry => entry.text.includes(query));
        if (!matches.length) { const empty = document.createElement('p'); empty.textContent = '没有匹配的章节'; results.append(empty); }
        for (const entry of matches) { const link = document.createElement('a'); link.href = `#${entry.id}`; link.textContent = entry.title; link.addEventListener('click', () => { results.hidden = true; }); results.append(link); }
      });
      search.addEventListener('keydown', event => { if (event.key === 'Enter') results.querySelector<HTMLAnchorElement>('a')?.click(); });
      document.addEventListener('click', event => { if (!(event.target as Element).closest('.page-search')) results.hidden = true; });
    </script>
  </body>
</html>
